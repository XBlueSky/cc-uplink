---
import Base from './Base.astro'
import StatusLine from '../components/StatusLine.astro'

const { title, slug } = Astro.props
---
<Base title={`${title} — cc-uplink`} description={`cc-uplink ${title}`}>
  <StatusLine current={slug} />
  <article class="doc">
    <a class="back" href="/">← back to cc-uplink</a>
    <slot />
  </article>
</Base>

<style>
  .doc {
    max-width: 68ch;
    margin: 0 auto;
    padding: var(--space-l) var(--space-m) var(--space-xl);
  }
  .back {
    display: inline-block;
    margin-bottom: var(--space-l);
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--ink-dim);
    text-decoration: none;
  }
  /* Carried Task-1-review finding: was the old link-accent alias (aliased
     to --green — 1.45:1 on paper, functionally invisible). --clay-ink is
     the paper-world link tone (5.1:1 on paper; see tokens.css's Role rule). */
  .back:hover { color: var(--clay-ink); }
  .doc :global(h1) { font-size: var(--step-2); line-height: 1.15; margin-bottom: var(--space-m); }
  .doc :global(h2) { font-size: var(--step-1); margin-top: var(--space-l); }
  /*
   * Prose links (rendered from markdown, e.g. security.md's SECURITY.md
   * link) — scoped here rather than left to tokens.css's global `a` rule,
   * which points straight at --green (paper-unaware, low-contrast here).
   * `:not(.back)` keeps this from re-painting the back-link above, which
   * is also an <a> inside .doc and already has its own colour.
   */
  .doc :global(a:not(.back)) { color: var(--clay-ink); }
  .doc :global(pre) {
    padding: var(--space-m);
    /* No `background` here: Shiki emits its own inline `background-color`
       on every <pre> it generates (`var(--astro-code-background)`,
       pointed straight at --term in tokens.css), and an inline style
       always wins over this external rule regardless of specificity. A
       `background` declaration here would never paint anything; keeping
       it would misrepresent which layer actually controls this colour.
       Code blocks stay dark instruments in this reskin (design spec:
       "code-on-dark is now a design feature, not a leftover") — only the
       border below moves to the new token name, not a new colour. */
    border: 1px solid var(--term-line);
    overflow-x: auto;
    font-size: var(--step--1);
  }
  .doc :global(code) { font-size: 0.95em; }
  /*
   * Inline code chips: manilla fill on paper prose (design spec's Tokens
   * section: "--manilla ... inline-code fill, tags"), matching the style
   * tile's `.beat-copy .k` chip exactly — no border, ink text (inherited
   * from body colour), small radius.
   */
  .doc :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    background: var(--manilla);
    border-radius: 3px;
    overflow-wrap: anywhere;
  }
  .doc :global(table) { width: 100%; border-collapse: collapse; font-size: var(--step--1); }
  /* Table borders are paper hairlines here (--leader), not instrument
     borders — the table sits in prose, not inside a Pane. */
  .doc :global(th), .doc :global(td) {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--leader);
    text-align: left;
  }
</style>
