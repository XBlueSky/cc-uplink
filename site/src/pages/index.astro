---
import Base from '../layouts/Base.astro'
import Ambience from '../components/Ambience.astro'
import StatusLine from '../components/StatusLine.astro'
import Act0 from '../components/acts/Act0.astro'
import Act1 from '../components/acts/Act1.astro'
import Act2 from '../components/acts/Act2.astro'
import Act3 from '../components/acts/Act3.astro'
import Act4 from '../components/acts/Act4.astro'
import Act5 from '../components/acts/Act5.astro'

import manifestJson from '../data/manifest.json'
import { parseManifest } from '../lib/manifest.mjs'
import { fetchLatestRelease, resolveRelease } from '../lib/release.mjs'

// Vite resolves this static JSON import relative to this module's own
// source path and inlines it at build time, so Astro's chunk relocation
// under `dist/.prerender/chunks/` (which broke a path computed from
// `manifest.mjs`'s `import.meta.url`, and later a path computed from
// `process.cwd()`) is no longer a hazard by construction — there is no
// runtime path arithmetic left to relocate. The manifest also joins the
// module graph this way, so `astro dev` re-renders when it changes instead
// of serving stale facts from an `fs.readFileSync` Vite can't see.
// `parseManifest` still applies every Task 4 guarantee — required fields,
// the exactly-six-tools check — so a bad manifest fails the build loudly.
const manifest = parseManifest(manifestJson)

const trap = manifest.traps[0] ?? ''
const tip = manifest.tips[1] ?? manifest.tips[0] ?? ''

// Act0's install command must name this repo, not a hardcoded slug — derive
// it from the manifest's own `repository` URL so a rename breaks the build
// instead of shipping a dead `/plugin marketplace add` command. `repository`
// is `string | null` and not a required manifest field, so guard it like the
// trap/tip lines above rather than assume it is always present.
const repoSlug = (manifest.repository ?? '')
  .replace(/^https?:\/\/github\.com\//, '')
  .replace(/\.git$/, '')
  .replace(/\/$/, '')

// The same slug feeds the release lookup: `fetchLatestRelease`/`resolveRelease`
// each default to a hardcoded `XBlueSky/cc-uplink`, which existed only because
// nothing here used to pass a `repo` argument. A repo rename would otherwise
// keep hitting the old GitHub API path (and therefore the old fallback URL)
// even after Act0's own install command had already picked up the rename —
// two facts on one page quietly disagreeing. `repoSlug || undefined` keeps
// each function's own default live when the manifest has no repository at
// all, rather than handing them an empty string.
const fetchedRelease = await fetchLatestRelease({ repo: repoSlug || undefined })
if (!fetchedRelease) {
  // The GitHub releases API is unauthenticated here (anonymous rate limit is
  // 60/hr/IP, and Pages builders share addresses aggressively), so a fallback
  // is a realistic, recurring event, not just an outage. Surfacing it at
  // build time is the follow-through on `fetchLatestRelease`/`resolveRelease`
  // deliberately not logging inside the leaf module — this page is the
  // caller, so this is where the layering says the warning belongs.
  console.warn(
    'cc-uplink site: could not fetch the latest GitHub release; falling back to the manifest version for the landing page release link.',
  )
}
const release = resolveRelease(fetchedRelease, manifest.version, repoSlug || undefined)
---
<Base title={`cc-uplink — ${manifest.tagline}`} description={manifest.description}>
  <Ambience />
  <StatusLine current="home" />
  <div class="acts" data-acts>
    <Act0
      tagline={manifest.tagline}
      intro={manifest.intro}
      release={release}
      repo={repoSlug}
      pluginName={manifest.name}
      marketplaceName={manifest.marketplace}
    />
    <Act1 />
    <Act2 />
    <Act3 trap={trap} />
    <Act4 tip={tip} />
    <Act5 tools={manifest.tools} />
  </div>

  <script>
    import { initTimeline, prefersReducedMotion } from '../scripts/timeline.mjs'
    import { initAmbience } from '../scripts/ambience.mjs'

    // Restored offsets are meaningless across the flow→pinned layout swap
    // (the pre-.motion document is a different height than the pinned one),
    // so starting at act 0 is deliberate — this must run before
    // initTimeline() is called, which is why it is the first statement in
    // this script body (the imports above hoist and have no scroll side
    // effects, so their position doesn't matter here).
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual'

    const root = document.querySelector('[data-acts]')
    const canvas = document.querySelector('[data-ambience]')
    const reducedMotion = prefersReducedMotion()

    const ambience = canvas ? initAmbience({ canvas, reducedMotion }) : null

    if (root) {
      initTimeline({
        root,
        onProgress: (p) => ambience?.setProgress(p),
      })
    }
  </script>

  <style>
    .acts { position: relative; }

    /*
     * Stacking is scoped to `.motion`, which only `initTimeline` adds — and
     * only once it can also drive the un-stacking. That keeps the page
     * correct both before JS runs and if it fails to load: acts stay in
     * normal document flow (the static layout is the design) until the
     * script proves it can take over.
     */
    .acts.motion {
      height: 100svh;
      min-height: 0;
      position: relative;
    }
    .acts.motion :global([data-act]) {
      position: absolute;
      inset: 0;
      display: grid;
      align-content: center;
      will-change: transform, opacity;
    }

    /* Compress act chrome only while pinned — the static layout (no JS,
       reduced motion) keeps its full padding untouched. */
    .acts.motion :global(.act) {
      padding-top: var(--space-m);
      padding-bottom: var(--space-m);
    }

    /* Act 4's figure is the tallest single element on the page; cap it so
       it can never be the reason an act doesn't fit the pinned box. */
    .acts.motion :global(.artifact img) {
      max-height: 30svh;
      width: auto;
      max-width: 100%;
      margin-inline: auto;
    }

    @media (max-height: 860px) {
      .acts.motion :global(h1) { font-size: var(--step-2); }
      .acts.motion :global(.act) { gap: var(--space-m); }
    }

    /*
     * Act 0 (headline h1 + full intro paragraph + install pane) is the
     * tallest act by a wide margin, and it is the one still over budget at
     * 1440x900 and 390x844 even after the 860px tier above — both are
     * *taller* than 860px, so that tier never engages for them. This tier
     * widens the h1 compression to cover them too (same step-2 value, so it
     * is a no-op wherever the 860px tier already applies) and additionally
     * compresses act 0's intro copy, its install block's own top margin, and
     * its release/version meta line — chrome and secondary copy, not the
     * headline or the install command itself.
     */
    @media (max-height: 920px) {
      .acts.motion :global(h1) { font-size: var(--step-2); }
      .acts.motion :global(.intro) { font-size: var(--step-0); line-height: 1.35; }
      .acts.motion :global(.install) { margin-top: var(--space-s); }
      .acts.motion :global(.meta) { font-size: calc(var(--step--1) * 0.82); }
    }

    /*
     * The narrowest and shortest of the five acceptance viewports
     * (390x664): act 0 is still tight, and every act's Pane (a
     * fixed-content code/terminal block whose line count and font-size are
     * unrelated to viewport width, so it doesn't shrink on its own the way
     * wrapped copy does) is the next-tallest thing after act 0. Compresses
     * Pane's own internal padding and line-height — its chrome, not its
     * text — everywhere it appears.
     */
    @media (max-height: 740px) {
      .acts.motion :global(h1) { font-size: var(--step-1); }
      .acts.motion :global(.pane-body) { padding: var(--space-s); line-height: 1.4; }
    }
  </style>
</Base>
