---
const { title, active = false } = Astro.props
---
<section class="pane" data-pane data-active={active ? 'true' : 'false'}>
  {title && <header class="pane-title">{title}</header>}
  <div class="pane-body"><slot /></div>
</section>

<style>
  .pane {
    border: 1px solid var(--pane-border);
    background: color-mix(in srgb, var(--bg-raised) 70%, transparent);
    display: flex;
    flex-direction: column;
    min-width: 0;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  /*
   * `border-color`/`box-shadow` are the storyboard's `.pane.active` glow
   * (`border-color: #5b7cfa; box-shadow: 0 0 24px rgba(91,124,250,.14)`),
   * ported here. `rgba(91,124,250,…)` is the storyboard's `--indigo-hi`,
   * byte-identical to this site's `--accent` token — both properties
   * deliberately reach for `--accent` to match the brighter blue the
   * storyboard renders for its ACTIVE pane. `--accent-dim` (the
   * storyboard's plainer `--indigo`) is that storyboard's INACTIVE panel
   * colour, not a faithful active mapping — an earlier port of this
   * component reached for it here by mistake, on the border-color half
   * only. `transition` on the base `.pane` rule above animates both
   * properties whenever `data-active` flips. No `prefers-reduced-motion`
   * guard is needed alongside it: `data-active` only ever changes in
   * enhanced mode (see enhance.mjs's initJourney), and reaching enhanced
   * mode already implies motion is allowed.
   */
  .pane[data-active='true'] {
    border-color: var(--accent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .pane-title {
    padding: 0.3rem var(--space-s);
    border-bottom: 1px solid var(--pane-border);
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--fg-dim);
  }
  .pane-body {
    position: relative;
    padding: var(--space-m);
    font-family: var(--mono);
    font-size: var(--step--1);
    line-height: 1.7;
    overflow-x: auto;
  }
  /*
   * The storyboard's `.pane pre` wraps long lines
   * (`white-space: pre-wrap; word-break: break-word`) — without this, the
   * §2 envelope's reply-instruction tail (the beat-2 teaching content) and
   * the peer's tmux reply command render as a single line that scrolls
   * horizontally inside the pane, i.e. they are invisible at rest on every
   * viewport. The document-level overflow checks never catch this because
   * `overflow-x: auto` above contains the scroll to the pane itself. Slot
   * content, hence :global().
   */
  .pane-body :global(pre) {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
</style>
