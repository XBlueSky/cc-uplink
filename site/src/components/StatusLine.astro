---
const { current } = Astro.props

const windows = [
  { id: 'home', label: 'home', href: '/' },
  { id: 'wire-contract', label: 'wire', href: '/docs/wire-contract' },
  { id: 'downstream-contracts', label: 'downstream', href: '/docs/downstream-contracts' },
  { id: 'configuration', label: 'config', href: '/docs/configuration' },
  { id: 'cli', label: 'cli', href: '/docs/cli' },
  { id: 'security', label: 'security', href: '/docs/security' },
]
---
<nav class="status" aria-label="Site navigation">
  <span class="session">[cc-uplink]</span>
  <ul>
    {windows.map((w, i) => (
      <li>
        <a href={w.href} aria-current={current === w.id ? 'page' : undefined}>
          {i}:{w.label}{current === w.id ? '*' : ''}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /*
   * The one dark chrome bar on the paper page (design spec's Surfaces &
   * chrome section) — a dark instrument strip, same term ground/border as
   * a Pane, but flat (no scanlines/glow of its own; it's a status strip,
   * not a CRT). `--amber`/`--term-line` are this task's new token names,
   * replacing the pre-reskin link-accent/`--pane-border` aliases (that
   * link-accent alias retires entirely per the design spec's Role rule).
   */
  .status {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    padding: 0.4rem var(--space-m);
    background: var(--term);
    border-bottom: 1px solid var(--term-line);
    font-family: var(--mono);
    font-size: var(--step--1);
    overflow-x: auto;
  }
  .session { color: var(--amber); flex: none; }
  ul {
    display: flex;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li { flex: none; }
  /*
   * Window links stay legible on the dark strip: #A99364 (dim) / #F2E7CF
   * (hover and current) are the same literal instrument-text tones Pane.astro
   * uses for its header/body — not named tokens (see that file's comments),
   * so kept literal here too for the same reason. `aria-current='page'`'s
   * markup and matching logic (StatusLine's `current` prop, set by
   * Doc.astro/404.astro) are untouched; only its resolved colour moves from
   * `--fg` (ink, illegible on dark) to this pair.
   */
  a { color: #A99364; text-decoration: none; white-space: nowrap; }
  a:hover { color: #F2E7CF; }
  a[aria-current='page'] { color: #F2E7CF; }
</style>
