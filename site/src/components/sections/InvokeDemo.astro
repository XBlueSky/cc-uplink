---
import Pane from '../Pane.astro'
import FigHeader from '../FigHeader.astro'

// Same reuse-the-constant-for-both approach as Journey.astro (see that
// file's comment): each line is a JS string used for both `data-text` and
// the rendered fallback text, so the two can never drift.
const ASK = '> generate a hero image of a lighthouse for the README'
const CALL = '⏺ channel_invoke(channel: "image:codex", op: "generate",\n      args: { prompt: "a lighthouse in watercolour" })'
const MID = '  ⎿ codex exec → built-in imagegen (via your ChatGPT login — no API key)'
const PATHS = '  ⎿ paths: ["~/project/lighthouse.png"]'
---
<section id="images" data-demo aria-labelledby="images-heading">
  <div class="fig-wrap"><FigHeader n={3} title="IMAGES" /></div>
  <div class="wrap">
    <!-- source-line wrapping below is deliberate: a newline adjacent to a
         tag edge collapses to zero-width, not a space, so every wrap point
         is kept between two plain words instead of touching a <span> edge -->
    <div class="copy" data-reveal>
      <h2 id="images-heading">Same six tools, a completely different channel</h2>
      <p class="body">
        Images go through the same fixed surface: one <span class="k">channel_invoke</span> call.
        The <span class="k">image:codex</span> driver shells out to Codex CLI's
        built-in imagegen under your ChatGPT login — <strong>no OpenAI API key anywhere</strong> — and
        hands back a file path on disk.
      </p>
    </div>
    <div class="demo" data-demo-box>
      <Pane title="tmux:%1 — claude" active={true}>
        <pre tabindex="0" role="region" aria-label="tmux pane contents: an image-generation channel_invoke call and its result"><span data-line data-typed data-text={ASK}>{ASK}</span><span class="caret" data-caret aria-hidden="true">▊</span>
<span data-line data-text={CALL}>{CALL}</span>
<span class="dim" data-line data-text={MID}>{MID}</span>
<span class="dim" data-line data-text={PATHS}>{PATHS}</span></pre>
      </Pane>
      <figure class="artifact" data-art>
        <img
          src="/act4-artifact.webp"
          alt="Watercolour lighthouse generated by the image:codex channel"
          width="1024"
          height="576"
          loading="lazy"
          decoding="async"
        />
        <figcaption>fig. 3b — generated by image:codex</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  /* Matches `.wrap`'s own max-width/padding formula (below) so the FIG
     header's leader rule lines up with the two-column grid under it. */
  .fig-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-l) var(--space-m) 0;
  }
  .wrap {
    padding: var(--space-xl) var(--space-m);
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  @media (min-width: 900px) { .wrap { grid-template-columns: 1fr 1.1fr; } }
  /* See Hero.astro: keeps this grid item from being forced wide by an
     unbreakable line in the pane's <pre>. */
  .copy { min-width: 0; }
  h2 { font-size: var(--step-2); line-height: 1.1; margin: 0 0 var(--space-m); }
  .body { color: var(--ink-dim); max-width: 46ch; margin: 0; }
  .body strong { color: var(--ink); font-weight: 600; }
  /* Manilla inline-code chip — see Journey.astro's own `.copy .k` comment;
     same paper-world treatment, kept identical across both sections. */
  .k {
    font-family: var(--mono);
    font-size: 0.92em;
    color: var(--ink);
    background: var(--manilla);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }

  .demo { min-width: 0; }
  :global([data-demo] pre) { margin: 0; overflow-x: auto; }
  /* Inside the Pane's `<pre>` (an instrument ground) — see Journey.astro's
     identical `.dim` comment for why this is Pane.astro's own literal dim
     tone rather than the paper-world --ink-dim. */
  .dim { color: #A99364; }

  /* Caret hook for the scroll-typed ask line — inert here; enhance.mjs
     drives it via this same file's own
     `.enhanced [data-demo].scrubbing [data-caret]` rule below. The
     static/flat page already shows the line's full text, so no blinking
     cursor is needed there. */
  [data-caret] { display: none; }
  .caret { color: var(--amber); }

  /*
   * Paper frame for the generated artifact (design spec §3/InvokeDemo: a
   * leader-bordered mat, like a print in a mount board) — the manilla
   * padding sits between the leader border and the image itself, and the
   * mono figcaption below reads as the drawing-set's own "fig. 3b" label,
   * styled the same clay-ink as every other fig. callout on this page.
   */
  .artifact {
    margin: var(--space-m) 0 0;
    padding: var(--space-s);
    background: var(--manilla);
    border: 1px solid var(--leader);
  }
  .artifact img {
    display: block;
    width: 100%;
    height: auto;
  }
  .artifact figcaption {
    margin-top: var(--space-s);
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--clay-ink);
  }

  /*
   * ── Enhanced mode: the §3 view-position scrub ──────────────────────
   * Hangs off `.enhanced` (added to <html> pre-paint by the gate script in
   * index.astro — see enhance.mjs's own gate comment) — same rule as
   * Journey.astro's own enhanced block, and the same reason: a flat
   * visitor never gets the class, so nothing below ever applies to them
   * and the flat markup (already showing every line/the artifact fully
   * visible) stands as the whole experience.
   *
   * Every rule that actually HIDES content also requires `.scrubbing` on
   * `[data-demo]` — a class `initDemo()` (enhance.mjs) adds only after it
   * has confirmed every element this scrub needs actually exists. Without
   * that second class, `.enhanced` alone hides nothing here: if a future
   * markup edit ever breaks the contract (drops a `[data-line]`, renames
   * `[data-art]`, …), `initDemo()` bails out before ever adding
   * `.scrubbing`, so this CSS never fires and the section falls back to
   * the fully-visible flat rendering instead of getting stuck hidden with
   * no JS left to turn it back on.
   *
   * This is a NARROWER protection than index.astro's load-time self-heal
   * (see enhance.mjs's own top-of-file gate comment): that heal only fires
   * when the whole module never got as far as setting `enhanceReady` (a
   * 404'd chunk, a blocked request, a parse error) — `initDemo()` runs well
   * after that flag is already set, so a markup edit that breaks only THIS
   * file's own contract, while the rest of the module still loads and runs
   * fine, would never trip it. `.scrubbing` is what actually covers that
   * case, for this file. (Journey.astro does NOT have this second gate yet
   * — its own `[data-line]` hiding rules still key off `.enhanced` alone,
   * so that same narrower failure mode there would render blank, not flat.
   * Tracked for a future round, not a contradiction.)
   *
   * `[data-line]`, `[data-typed]`, `[data-caret]` and `[data-art]` are all
   * authored directly in this file's template (including as slotted
   * children of <Pane>, which count as authored here — see Journey.astro's
   * comment on why that distinction matters for `[data-pane]` itself), so
   * plain scoped selectors reach them with no `:global()` workaround needed
   * beyond wrapping `.enhanced`.
   */
  :global(.enhanced) [data-demo].scrubbing [data-line]:not([data-typed]) {
    opacity: 0;
    transition: opacity 0.3s;
  }
  :global(.enhanced) [data-demo].scrubbing [data-line]:not([data-typed]).on {
    opacity: 1;
  }
  :global(.enhanced) [data-demo].scrubbing [data-caret] {
    display: inline-block;
  }
  :global(.enhanced) [data-demo].scrubbing [data-art] {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  :global(.enhanced) [data-demo].scrubbing [data-art].on {
    opacity: 1;
  }

  /*
   * One-time reveal for the intro `.copy` block (the storyboard has this
   * too — its own §3 block opens with a `.reveal` div). Same rule/rationale
   * as ToolsGrid.astro's own enhanced block: hangs off `.enhanced` alone
   * (not `.scrubbing` — this target has nothing to do with the demo scrub
   * itself, it's the shared `initReveals()` IntersectionObserver, which
   * doesn't care whether `initDemo()` ever wired up successfully). Just
   * one `[data-reveal]` target in this file, so no stagger needed.
   */
  :global(.enhanced) [data-reveal] {
    opacity: 0;
    translate: 0 26px;
    transition: opacity 0.7s ease, translate 0.7s ease;
  }
  :global(.enhanced) [data-reveal].in {
    opacity: 1;
    translate: none;
  }
</style>
