---
import Pane from '../Pane.astro'

// Same reuse-the-constant-for-both approach as Journey.astro (see that
// file's comment): each line is a JS string used for both `data-text` and
// the rendered fallback text, so the two can never drift.
const ASK = '> generate a hero image of a lighthouse for the README'
const CALL = '⏺ channel_invoke(channel: "image:codex", op: "generate",\n      args: { prompt: "a lighthouse in watercolour" })'
const MID = '  ⎿ codex exec → built-in imagegen (via your ChatGPT login — no API key)'
const PATHS = '  ⎿ paths: ["~/project/lighthouse.png"]'
---
<section id="images" data-demo aria-labelledby="images-heading">
  <div class="wrap">
    <!-- source-line wrapping below is deliberate: a newline adjacent to a
         tag edge collapses to zero-width, not a space, so every wrap point
         is kept between two plain words instead of touching a <span> edge -->
    <div class="copy">
      <h2 id="images-heading">Same six tools, a completely different channel</h2>
      <p class="body">
        Images go through the same fixed surface: one <span class="k">channel_invoke</span> call.
        The <span class="k">image:codex</span> driver shells out to Codex CLI's
        built-in imagegen under your ChatGPT login — <strong>no OpenAI API key anywhere</strong> — and
        hands back a file path on disk.
      </p>
    </div>
    <div class="demo">
      <Pane title="tmux:%1 — claude" active={true}>
        <pre tabindex="0" role="region" aria-label="tmux pane contents: an image-generation channel_invoke call and its result"><span data-line data-typed data-text={ASK}>{ASK}</span><span class="caret" data-caret aria-hidden="true">▊</span>
<span data-line data-text={CALL}>{CALL}</span>
<span class="dim" data-line data-text={MID}>{MID}</span>
<span class="dim" data-line data-text={PATHS}>{PATHS}</span></pre>
      </Pane>
      <figure class="artifact" data-art>
        <img
          src="/act4-artifact.webp"
          alt="Watercolour lighthouse generated by the image:codex channel"
          width="1024"
          height="576"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Generated by image:codex — the channel this page is describing.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .wrap {
    padding: var(--space-xl) var(--space-m);
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  @media (min-width: 900px) { .wrap { grid-template-columns: 1fr 1.1fr; } }
  /* See Hero.astro: keeps this grid item from being forced wide by an
     unbreakable line in the pane's <pre>. */
  .copy { min-width: 0; }
  h2 { font-size: var(--step-2); line-height: 1.1; margin: 0 0 var(--space-m); }
  .body { color: var(--fg-dim); max-width: 46ch; margin: 0; }
  .body strong { color: var(--fg); font-weight: 600; }
  .k { font-family: var(--mono); font-size: 0.92em; color: var(--fg); }

  .demo { min-width: 0; }
  :global([data-demo] pre) { margin: 0; overflow-x: auto; }
  .dim { color: var(--fg-dim); }

  /* Caret hook for the scroll-typed ask line — inert until a later
     enhancement layer drives it; the static/flat page already shows the
     line's full text, so no blinking cursor is needed. */
  [data-caret] { display: none; }
  .caret { color: var(--cyan); }

  .artifact { margin: var(--space-m) 0 0; }
  .artifact img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--pane-border);
    /*
     * Visible by default — this is the no-JS/static state. A later
     * enhancement layer starts this at opacity 0 and adds `.on` once the
     * demo pane's typewriter has finished, gated behind whatever class it
     * introduces (see Journey.astro's `.beam` comment for the same pattern).
     */
    opacity: 1;
  }
  .artifact figcaption {
    margin-top: var(--space-s);
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--fg-dim);
  }

  /*
   * ── Enhanced mode: the §3 view-position scrub ──────────────────────
   * Hangs off `.enhanced` (added to <html> by enhance.mjs, only past its
   * gate) — same rule as Journey.astro's own enhanced block, and the same
   * reason: a flat visitor never gets the class, so nothing below ever
   * applies to them and the flat markup (already showing every line/the
   * artifact fully visible) stands as the whole experience.
   *
   * `[data-line]`, `[data-typed]`, `[data-caret]` and `[data-art]` are all
   * authored directly in this file's template (including as slotted
   * children of <Pane>, which count as authored here — see Journey.astro's
   * comment on why that distinction matters for `[data-pane]` itself), so
   * plain scoped selectors reach them with no `:global()` workaround needed
   * beyond wrapping `.enhanced`.
   */
  :global(.enhanced) [data-demo] [data-line]:not([data-typed]) {
    opacity: 0;
    transition: opacity 0.3s;
  }
  :global(.enhanced) [data-demo] [data-line]:not([data-typed]).on {
    opacity: 1;
  }
  :global(.enhanced) [data-demo] [data-caret] {
    display: inline-block;
  }
  :global(.enhanced) [data-demo] [data-art] {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  :global(.enhanced) [data-demo] [data-art].on {
    opacity: 1;
  }
</style>
