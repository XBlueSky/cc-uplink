---
const { release, repo, pluginName, marketplaceName } = Astro.props
// Same marketplace-name-vs-plugin-name distinction as Hero.astro — see that
// file for why the fallback exists.
const marketplaceSlug = marketplaceName ?? pluginName
const repoUrl = `https://github.com/${repo}`
---
<footer id="end" aria-labelledby="footer-heading">
  <div data-reveal>
    <h2 id="footer-heading">Open a channel</h2>
    <div class="install">
      <pre><code>/plugin marketplace add {repo}
/plugin install {pluginName}@{marketplaceSlug}</code></pre>
      <button type="button" data-copy>copy</button>
    </div>
    <!-- source-line wrapping is deliberate: a newline adjacent to a tag
         edge collapses to zero-width, not a space, so this stays on one
         line rather than wrapping next to the two <a> tags -->
    <p class="meta">
      <a href={release.url}>{release.tag}</a> · MIT · <a href={repoUrl}>github.com/{repo}</a>
    </p>
  </div>
</footer>

<style>
  footer {
    padding: var(--space-xl) var(--space-m);
    text-align: center;
    position: relative;
  }
  h2 { font-size: var(--step-2); line-height: 1.1; margin: 0 0 var(--space-l); }
  .install {
    display: inline-flex;
    /*
     * `inline-flex` shrink-to-fits to its content's PREFERRED (max-content)
     * width — unlike Hero.astro's `.install` (a block-level `display: flex`,
     * which fills its container's available width and so was never at
     * risk here), an inline-level box's shrink-to-fit sizing ignores the
     * containing block's width entirely unless capped. The install `<pre>`
     * below has its own `overflow-x: auto`, but that only turns overflow
     * into a scrollbar once something has already bounded this box's
     * outer width — without `max-width: 100%` this element's un-scrolled,
     * un-clamped preferred width (the full unbroken install command, ~336px)
     * became the footer's actual rendered width at a 320px viewport,
     * blowing out the page's horizontal scroll.
     */
    max-width: 100%;
    align-items: flex-start;
    gap: var(--space-s);
    flex-wrap: wrap;
    padding: var(--space-m);
    background: var(--bg-raised);
    border: 1px solid var(--pane-border);
    text-align: left;
  }
  .install pre {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--step--1);
    overflow-x: auto;
  }
  .install button {
    flex: none;
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--cyan);
    background: none;
    border: 1px solid var(--pane-border);
    padding: 0.25rem var(--space-s);
    cursor: pointer;
  }
  .install button:hover,
  .install button:focus-visible {
    border-color: var(--cyan);
    outline: none;
  }
  /*
   * Paint-stable copy button — same mechanism/rationale as Hero.astro's own
   * `[data-copy]` rule (see that file's comment): hidden by CSS keyed off
   * `has-clipboard` (stamped on `<html>` pre-paint, alongside `enhanced`, by
   * index.astro's gate script), not the `hidden` HTML attribute + a later
   * JS un-hide, so the module wiring the click handler causes zero shift.
   */
  [data-copy] { display: none; }
  :global(.has-clipboard) [data-copy] { display: inline-block; }
  .meta {
    margin-top: var(--space-m);
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--fg-dim);
  }
  .meta a { color: var(--fg-dim); }
  .meta a:hover { color: var(--cyan); }

  /*
   * ── Enhanced mode: one-time reveal ─────────────────────────────────
   * Same rule/rationale as ToolsGrid.astro's own enhanced block. Just one
   * `[data-reveal]` target here (the whole footer body), so no stagger.
   */
  :global(.enhanced) [data-reveal] {
    opacity: 0;
    translate: 0 26px;
    transition: opacity 0.7s ease, translate 0.7s ease;
  }
  :global(.enhanced) [data-reveal].in {
    opacity: 1;
    translate: none;
  }
</style>
