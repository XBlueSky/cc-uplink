---
// One factual, English sentence per doc page — written fresh for this
// redesign (the storyboard's own hooks are Traditional Chinese and are
// explicitly storyboard-only teaching aids, not shippable copy).
const cards = [
  {
    href: '/docs/wire-contract/',
    title: 'wire-contract',
    hook: 'The Driver trait and its DTOs — the shapes a future out-of-process driver protocol has to match.',
  },
  {
    href: '/docs/security/',
    title: 'security',
    hook: 'Argv-only dispatch, env-only secrets, and why injected envelopes are visible plaintext by design.',
  },
  {
    href: '/docs/cli/',
    title: 'cli',
    hook: 'Every channel op from a shell — doctor, send, invoke, log — no LLM required.',
  },
  {
    href: '/docs/configuration/',
    title: 'configuration',
    hook: "The full channels.toml surface — every driver's optional settings in one file.",
  },
  {
    href: '/docs/downstream-contracts/',
    title: 'downstream-contracts',
    hook: 'The external APIs each driver actually speaks to, and the boundary driver authors must not cross.',
  },
]
---
<section class="docs-sec" id="docs" aria-labelledby="docs-heading">
  <div>
    <div class="intro" data-reveal>
      <h2 id="docs-heading">Read the contracts</h2>
      <p class="body">The parts most tools hide are the parts this one documents.</p>
    </div>
    <div class="cards">
      {cards.map((card) => (
        <a class="card" data-reveal href={card.href}>
          <b>{card.title}</b>
          <span>{card.hook}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .docs-sec {
    padding: var(--space-xl) var(--space-m);
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  h2 { font-size: var(--step-2); line-height: 1.1; margin: 0 0 var(--space-m); }
  .body { color: var(--fg-dim); max-width: 52ch; margin: 0 auto; }
  .cards {
    margin-top: var(--space-l);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-s);
    text-align: left;
  }
  .card {
    display: block;
    border: 1px solid var(--pane-border);
    padding: var(--space-m);
    background: color-mix(in srgb, var(--bg-raised) 70%, transparent);
    text-decoration: none;
    transition: border-color 0.25s;
  }
  .card:hover,
  .card:focus-visible {
    border-color: var(--cyan);
    outline: none;
  }
  .card b {
    display: block;
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--fg);
    font-weight: 500;
  }
  .card span {
    display: block;
    margin-top: var(--space-s);
    font-size: var(--step--1);
    color: var(--fg-dim);
    line-height: 1.5;
  }
</style>
