---
import Pane from '../Pane.astro'

// Every line below is a JS string constant reused for BOTH a span's
// `data-text` attribute and its rendered children, so Astro's own HTML
// escaping runs identically on both — the two can never drift out of sync
// the way two hand-escaped copies of the same string could.
//
// Wire strings mirror `src/core/envelope.rs::format_outbound`'s
// `ReplyHint::Full` shape exactly (from:claude, pane:%1, id:6b3b20e6,
// message:"review my diff"): head = `[uplink from:{from} pane:{own_pane}
// id:{id}] {message}`, tail = ` (reply: run \`tmux send-keys -t {own_pane}
// -l '[reply id:{id}] <your answer>' \; send-keys -t {own_pane} Enter\`)`.
const ASK = '> ask codex to review my diff'
const CALL = '⏺ channel_send(to: "tmux:%3", message: "review my diff")'
const RECEIPT = '  ⎿ delivered · id:6b3b20e6 · injection verified'
const REPLY = '[reply id:6b3b20e6] LGTM — one nit: retry.rs:41 swallows the error cause'

const IDLE = '▌idle'
const ENV_HEAD = '[uplink from:claude pane:%1 id:6b3b20e6] review my diff'
const ENV_TAIL = " (reply: run `tmux send-keys -t %1 -l '[reply id:6b3b20e6] <your answer>' \\; send-keys -t %1 Enter`)"
const WORK1 = '> reading the envelope… reviewing 3 files'
const WORK2 = '> retry.rs:41 swallows the error cause'
const REPLY_CMD = "$ tmux send-keys -t %1 -l '[reply id:6b3b20e6] LGTM — one nit: retry.rs:41 swallows the error cause' \\; send-keys -t %1 Enter"
---
<section id="journey" data-journey aria-label="signal journey">
  <!--
    Always present, regardless of flat/enhanced — the flat page's two <pre>
    panes are themselves readable, so this is a plain-language summary
    layered in front of them, not a replacement. In enhanced mode
    enhance.mjs marks both <pre> panes aria-hidden (the pinned scrub types
    them out letter by letter, which a screen reader would otherwise read
    as it happens); this paragraph is what stays describing the exchange
    for that visitor, and it never depends on JS to exist or to be visible
    to sighted users — CSS clips it unconditionally.
  -->
  <p class="sr-only">
    Transcript: you ask codex, running in the pane next door, to review your
    diff via <span class="k">channel_send</span>. cc-uplink delivers the
    request as one injected line in codex's terminal, carrying the exact
    reply command to run. Codex reviews three files, notes that
    retry.rs:41 swallows the error cause, and runs the reply command
    verbatim. The reply — "LGTM — one nit: retry.rs:41 swallows the error
    cause" — lands back in your own pane, correlation id matching the one
    you sent.
  </p>
  <div class="track" data-track>
    <div class="stage" data-stage>
      <div class="stage-inner">
        <div class="frame">
          <p class="beatmark">signal journey <b data-beat>[4/4]</b></p>
          <div class="panes">
            <div data-pane-you>
              <Pane title="tmux:%1 — claude (you)" active={true}>
                <pre tabindex="0" role="region" aria-label="tmux pane contents: your side of the exchange">$ claude
<span data-line data-typed data-text={ASK}>{ASK}</span><span class="caret" data-caret aria-hidden="true">▊</span>
<span data-line data-text={CALL}>{CALL}</span>
<span class="dim" data-line data-text={RECEIPT}>{RECEIPT}</span>
<span class="reply" data-line data-text={REPLY}>{REPLY}</span></pre>
              </Pane>
            </div>
            <div data-pane-peer>
              <Pane title="tmux:%3 — codex (peer)">
                <pre tabindex="0" role="region" aria-label="tmux pane contents: the peer's side of the exchange, including the injected envelope"><span class="dim">{IDLE}</span>
<span class="env" data-line data-text={ENV_HEAD}>{ENV_HEAD}</span><span class="envtail" data-line data-text={ENV_TAIL}>{ENV_TAIL}</span>
<span data-line data-text={WORK1}>{WORK1}</span>
<span data-line data-text={WORK2}>{WORK2}</span>
<span data-line data-typed data-text={REPLY_CMD}>{REPLY_CMD}</span><span class="caret" data-caret aria-hidden="true">▊</span></pre>
              </Pane>
            </div>
            <div class="beam" data-beam aria-hidden="true"><span class="packet" data-packet></span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- source-line wrapping below is deliberate: a newline adjacent to a
         tag edge collapses to zero-width, not a space, so every wrap point
         is kept between two plain words instead of touching a <span> edge -->
    <div class="copy" data-beat-copy>
      <h2>A peer, in the pane next door</h2>
      <p>
        Whatever runs in another tmux pane — the Codex CLI, another Claude, a
        plain shell — is addressable. You ask in plain words; <span class="k">channel_send</span> wraps
        it into an envelope. <span class="k">The peer installs nothing.</span>
      </p>
    </div>
    <div class="copy" data-beat-copy>
      <h2>The notification is the message itself</h2>
      <p>
        cc-uplink injects <span class="k">one plaintext line</span> into the
        peer's terminal — that line IS the notification. Its tail carries the
        exact command to reply with: a correlation id and a <span class="k">tmux send-keys</span> back
        to your pane.
      </p>
    </div>
    <div class="copy" data-beat-copy>
      <h2>The peer answers by running what it was handed</h2>
      <p>
        codex does the review, then runs the reply command verbatim. No SDK,
        no webhook, no queue — <span class="k">the envelope was the protocol.</span>
      </p>
    </div>
    <div class="copy" data-beat-copy>
      <h2>The reply lands in your pane, not in a queue</h2>
      <p>
        The <span class="k">[reply id:…]</span> line arrives in your own
        pane, correlation id matching the one you sent. <span class="k">channel_recv</span> stays
        an audit log — nothing to poll, ever.
      </p>
    </div>
  </div>
</section>

<style>
  /*
   * Flat by default (matches the storyboard's `body.flat` overrides
   * unconditionally) — this is what a reduced-motion or narrow-viewport
   * visitor gets, and it's the whole page for a no-JS visitor too, so it
   * has to stand on its own as the complete experience. `.beam` and
   * `.packet` below are pre-positioned to the storyboard's non-flat
   * geometry but hidden via `display: none`; the enhanced-mode block at the
   * bottom of this file only has to flip visibility on top of this layout,
   * not rebuild it. See that block for how `.enhanced` (added to <html> by
   * site/src/scripts/enhance.mjs, and ONLY by it, after its own gate
   * passes) turns this into the pinned 460vh/4-beat scroll scrub.
   */
  .track { position: relative; }
  .stage { padding: var(--space-xl) 0; }
  .stage-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-m);
    display: flex;
    justify-content: center;
  }
  .frame { width: min(640px, 92vw); position: relative; }
  .panes { display: grid; gap: var(--space-l); position: relative; }
  .beatmark {
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--fg-dim);
    margin: 0 0 var(--space-s);
    letter-spacing: 0.08em;
  }
  .beatmark b { color: var(--cyan); font-weight: 400; }

  :global([data-pane-you] pre),
  :global([data-pane-peer] pre) {
    margin: 0;
    overflow-x: auto;
  }
  .dim { color: var(--fg-dim); }
  .reply { color: var(--cyan); }
  .env { color: var(--signal); }
  /* 55% measured ~3.45:1 against --bg — under the 4.5:1 AA floor for
     content this meaningful (it's the reply instructions). 67% clears it. */
  .envtail { color: color-mix(in srgb, var(--signal) 67%, transparent); }

  /* Caret hooks for the two scroll-typed lines in this section — inert by
     default; the static/flat page already shows each line's full text, so
     no blinking cursor is needed there. enhance.mjs flips these visible
     (see the `.enhanced` block below) only once it's driving the typing
     itself. */
  [data-caret] { display: none; }
  .caret { color: var(--cyan); }

  /* Standard visually-hidden-but-screen-reader-visible clip — present
     unconditionally (see the <p class="sr-only"> above the track). */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .beam {
    display: none;
    position: absolute;
    left: 8%;
    right: 8%;
    top: 50%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--signal), transparent);
    pointer-events: none;
  }
  .packet {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--signal);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border: 1px solid color-mix(in srgb, var(--signal) 55%, transparent);
    border-radius: 3px;
    padding: 3px 9px;
  }

  .copy {
    max-width: 52ch;
    margin: 0 auto;
    padding: var(--space-l) var(--space-m) var(--space-s);
  }
  .copy h2 { font-size: var(--step-2); line-height: 1.2; margin: 0 0 var(--space-m); }
  .copy p { color: var(--fg-dim); }
  .copy .k { font-family: var(--mono); font-size: 0.92em; color: var(--fg); }

  /*
   * ── Enhanced mode: the pinned scroll scrub ─────────────────────────
   * Everything below hangs off `.enhanced` on <html>, which only
   * site/src/scripts/enhance.mjs adds, and only after its own gate
   * (reduced-motion / narrow viewport) passes. That ordering is the whole
   * point: this block can never apply before JS has decided the visitor
   * gets the pinned scene, so a flat visitor never sees a flash of hidden
   * text or a pinned layout it doesn't get to unpin.
   *
   * `:global()` is required throughout — not just for the `.enhanced`
   * ancestor, but because several of these selectors reach into
   * Pane.astro's own rendered markup ([data-pane]), which doesn't carry
   * this component's scope attribute.
   */
  :global(.enhanced) [data-track] {
    height: 460vh;
  }
  :global(.enhanced) [data-stage] {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  :global(.enhanced) [data-journey] .stage-inner {
    justify-content: end;
  }
  :global(.enhanced) [data-journey] .frame {
    width: min(640px, 54vw);
  }
  :global(.enhanced) [data-beam] {
    display: block;
    opacity: 0;
    transition: opacity 0.3s;
  }

  /*
   * Left-column beat copy, absolutely positioned over the pinned stage as
   * the track scrolls underneath it — same left-edge formula as
   * `.stage-inner`'s own max-width/padding (1200px / --space-m), just
   * inverted from "center the wrap" to "start the wrap's left edge".
   * `.track` is `position: relative` unconditionally above, so these
   * percentage `top` values resolve against the 460vh track, not the
   * viewport. The four blocks are told apart purely by DOM order — `>`
   * anchored to `[data-track]` so nth-child counts `.stage` as child 1 and
   * the four `[data-beat-copy]` blocks as children 2–5 — rather than by
   * adding index attributes the landing-page markup tests don't expect.
   */
  :global(.enhanced) [data-journey] [data-beat-copy] {
    position: absolute;
    z-index: 6;
    width: min(36ch, 32vw);
    left: max(calc((100vw - 1200px) / 2 + var(--space-m)), var(--space-m));
  }
  :global(.enhanced) [data-track] > [data-beat-copy]:nth-child(2) { top: 6%; }
  :global(.enhanced) [data-track] > [data-beat-copy]:nth-child(3) { top: 31%; }
  :global(.enhanced) [data-track] > [data-beat-copy]:nth-child(4) { top: 56%; }
  :global(.enhanced) [data-track] > [data-beat-copy]:nth-child(5) { top: 80%; }

  /*
   * Animated lines start hidden and fade in via `.on` (added/removed by
   * enhance.mjs's scrub). The two typewriter targets ([data-typed]) are
   * exempt from this opacity regime — the script empties their textContent
   * instead of fading them, so a scrub reversal shrinks the typed text
   * back down rather than also replaying a fade.
   */
  :global(.enhanced) [data-journey] [data-line]:not([data-typed]) {
    opacity: 0;
    transition: opacity 0.3s;
  }
  :global(.enhanced) [data-journey] [data-line]:not([data-typed]).on {
    opacity: 1;
  }
  :global(.enhanced) [data-journey] [data-caret] {
    display: inline-block;
  }

  /* Pane focus: the peer pane's `active` state reuses Pane.astro's own
     `[data-active]` attribute selector (no new CSS needed for that half);
     `.faded` is new here, for the you-pane while the peer has focus. */
  :global(.enhanced) [data-journey] [data-pane] {
    transition: opacity 0.3s;
  }
  :global(.enhanced) [data-journey] [data-pane].faded {
    opacity: 0.55;
  }
</style>
