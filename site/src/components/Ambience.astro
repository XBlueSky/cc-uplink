<div class="ambience" aria-hidden="true">
  <canvas data-ambience></canvas>
</div>

<style>
  .ambience {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* The always-present fallback: a static reading of the same art
       direction as the shader — dark base, one soft diagonal beam of
       indigo shading to cyan. If WebGL never initialises, this is the
       design, not an empty box. */
    background:
      linear-gradient(
        62deg,
        transparent 34%,
        color-mix(in srgb, var(--accent-dim) 42%, transparent) 50%,
        transparent 66%
      ),
      radial-gradient(
        120% 80% at 12% 96%,
        color-mix(in srgb, var(--accent-dim) 30%, transparent),
        transparent 60%
      ),
      var(--bg);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    /* Hidden until a renderer paints, so a failed WebGL init leaves the
       gradient visible rather than covering it with a black rectangle. */
    opacity: 0;
    transition: opacity 400ms ease;
  }

  canvas[data-ready='true'] { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    canvas { transition: none; }
  }
</style>
