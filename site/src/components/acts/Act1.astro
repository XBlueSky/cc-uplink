---
import Pane from '../Pane.astro'
---
<section class="act" data-act="1" aria-labelledby="act1-heading">
  <div class="copy">
    <h2 id="act1-heading">A peer, in the pane next door</h2>
    <p>
      Whatever runs in another tmux pane — the Codex CLI, another Claude, a
      plain shell — is now addressable. The peer installs nothing.
    </p>
  </div>
  <div class="split">
    <Pane title="$ claude" active={true}>
      <p>&gt; ask codex to review my diff</p>
    </Pane>
    <Pane title="tmux:%3 — codex">
      <p>&gt; <span class="dim">idle</span></p>
    </Pane>
  </div>
</section>

<style>
  .act {
    display: grid;
    gap: var(--space-l);
    padding: var(--space-xl) var(--space-m);
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }
  @media (min-width: 900px) { .act { grid-template-columns: 1fr 1.2fr; } }
  /* See Act0.astro: keeps this grid item from being forced wide by an
     unbreakable line in its content. */
  .copy { min-width: 0; }
  h2 { font-size: var(--step-2); line-height: 1.1; margin: 0 0 var(--space-m); }
  .copy p { color: var(--fg-dim); max-width: 42ch; }
  .split { display: grid; gap: var(--space-s); }
  @media (min-width: 640px) { .split { grid-template-columns: 1fr 1fr; } }
  .dim { color: var(--fg-dim); }
</style>
