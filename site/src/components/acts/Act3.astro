---
import Pane from '../Pane.astro'

const { trap } = Astro.props
---
<section class="act" data-act="3" aria-labelledby="act3-heading">
  <div class="copy">
    <h2 id="act3-heading">The reply lands in your pane, not in a queue</h2>
    <p class="trap">{trap}</p>
  </div>
  <Pane title="$ claude" active={true}>
    <p>&gt; ask codex to review my diff</p>
    <p class="reply">[reply id:a3f] LGTM — one nit on error handling</p>
  </Pane>
</section>

<style>
  .act {
    display: grid;
    gap: var(--space-l);
    padding: var(--space-xl) var(--space-m);
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }
  @media (min-width: 900px) { .act { grid-template-columns: 1fr 1.2fr; } }
  h2 { font-size: var(--step-2); line-height: 1.1; margin: 0 0 var(--space-m); }
  .trap { color: var(--fg-dim); max-width: 46ch; }
  .reply { color: var(--cyan); }
</style>
