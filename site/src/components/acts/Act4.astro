---
import Pane from '../Pane.astro'

const { tip } = Astro.props
---
<section class="act" data-act="4" aria-labelledby="act4-heading">
  <div class="copy">
    <h2 id="act4-heading">Same six tools, a completely different channel</h2>
    <p>{tip}</p>
  </div>
  <Pane title="channel_invoke" active={true}>
    <pre tabindex="0" role="region" aria-label="channel_invoke call and its result"><code>channel_invoke {"{"}
  channel: "image:codex",
  op: "generate",
  args: {"{"} prompt: "a lighthouse in watercolour — save it as lighthouse.png" {"}"}
{"}"}

→ paths: ["/Users/you/project/lighthouse.png"]</code></pre>
  </Pane>
  <figure class="artifact">
    <img
      src="/act4-artifact.webp"
      width="1024"
      height="576"
      loading="lazy"
      decoding="async"
      alt="A watercolour lighthouse at night, its beam sweeping over dark water."
    />
    <figcaption>
      Generated by <code>image:codex</code> — the channel this page is describing.
    </figcaption>
  </figure>
</section>

<style>
  .act {
    display: grid;
    gap: var(--space-l);
    padding: var(--space-xl) var(--space-m);
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }
  @media (min-width: 900px) { .act { grid-template-columns: 1fr 1.2fr; } }
  /* See Act0.astro: keeps this grid item from being forced wide by an
     unbreakable line — `tip` is marketplace-entry text, not this repo's. */
  .copy { min-width: 0; }
  h2 { font-size: var(--step-2); line-height: 1.1; margin: 0 0 var(--space-m); }
  .copy p { color: var(--fg-dim); max-width: 44ch; }
  pre { margin: 0; overflow-x: auto; }
  .artifact { margin: var(--space-m) 0 0; }
  .artifact img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--pane-border);
  }
  .artifact figcaption {
    margin-top: var(--space-s);
    font-family: var(--mono);
    font-size: var(--step--1);
    color: var(--fg-dim);
  }
</style>
